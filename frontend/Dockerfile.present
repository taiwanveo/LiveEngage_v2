FROM node:22-bookworm-slim AS build

WORKDIR /src
COPY frontend ./frontend
WORKDIR /src/frontend/apps/present

ARG VITE_API_BASE=https://le-api.zeabur.app
ENV VITE_API_BASE=$VITE_API_BASE

RUN npm install --prefix ../../packages/renderers \
    && npm install --prefix ../../packages/realtime \
    && npm install \
    && npx vite build

FROM docker.io/zeabur/caddy-static:latest

COPY --from=build /src/frontend/apps/present/dist /usr/share/caddy
