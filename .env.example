# LiveEngage 環境變數範本 — 複製為 .env 後填入真實值（.env 不可提交）

# ── 應用 ───────────────────────────────────────────────
LE_ENV=dev
LE_DEBUG=true
LE_LOG_LEVEL=INFO

# ── PostgreSQL（async 連線；驅動 asyncpg）──────────────
# 本地：docker-compose 預設值
# 生產（Neon）：請選 **Asia Pacific（東京 ap-northeast-1 或首爾鄰近區）** 以降低 Zeabur↔DB 延遲
# API 執行期請用 **Pooler** 連線（主機名含 `-pooler`），勿用 direct 連線
# async 驅動（asyncpg）— Neon 用 ssl=require
LE_DATABASE_URL=postgresql+asyncpg://liveengage:liveengage@localhost:5432/liveengage?ssl=require

# Alembic / 同步驅動（migration 用，psycopg）；migration 可用 direct 或 pooler
LE_DATABASE_URL_SYNC=postgresql+psycopg://liveengage:liveengage@localhost:5432/liveengage

# 生產範例（Neon Pooler，請替換為 Dashboard 實際值）：
# LE_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.ap-northeast-1.aws.neon.tech/neondb?ssl=require
# LE_DATABASE_URL_SYNC=postgresql+psycopg://user:pass@ep-xxx-pooler.ap-northeast-1.aws.neon.tech/neondb?sslmode=require

# ── Redis（Pub/Sub、計數、rate limit）──────────────────
# 本地：docker-compose → redis://localhost:6379/0
# Upstash 雲端：用 TLS 協定 URL（非 REST API）
# LE_REDIS_URL=rediss://default:<UPSTASH_TOKEN>@<name>.upstash.io:6379
LE_REDIS_URL=redis://localhost:6379/0

# ── JWT（鐵律 9：機密不得進 log）───────────────────────
# 正式環境用 RS256 金鑰；此處僅放 placeholder
LE_JWT_SECRET=change-me-in-production
LE_JWT_ALGORITHM=HS256
LE_JWT_ACCESS_TTL_MINUTES=15
LE_JWT_REFRESH_TTL_DAYS=14

# ── 物件儲存（S3 相容；任務 7+ 啟用）──────────────────
LE_S3_ENDPOINT=
LE_S3_BUCKET=
LE_S3_ACCESS_KEY=
LE_S3_SECRET_KEY=
